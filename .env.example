# Copy this file to .env and fill in your own values.
# .env is gitignored and should never be committed.

# Required — get a free key at https://console.groq.com
GROQ_API_KEY=

# Required — get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# Optional — if omitted, response caching silently no-ops and everything
# else works normally. Free Redis available at https://upstash.com
# Must use the TLS scheme (rediss://, not redis://) for Upstash.
REDIS_URL=
